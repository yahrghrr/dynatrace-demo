# /etc/default/dynatrace-demo-loadgen — steady-state ("baseline") load.
# Re-read every second; no restart needed. Easiest to change with:
#   dtdemo-load baseline <REQ/MIN> <ERR%>

# App URL (change the port if you set SERVER_PORT in /etc/default/dynatrace-demo)
BASE_URL=http://localhost:8080

# Total requests per minute (60 = 1/s). Keep >= ~10/min so Davis evaluates the service.
REQUESTS_PER_MIN=60

# Percentage of requests sent to /error (background noise; 0 = no errors)
ERROR_PCT=2
