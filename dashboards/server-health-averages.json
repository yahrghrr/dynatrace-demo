{
  "version": 15,
  "variables": [],
  "tiles": {
    "0": {
      "type": "markdown",
      "title": "",
      "content": "## Server health: fleet averages\nAverage **CPU**, **memory** and **disk** usage across **all monitored hosts** for the selected timeframe. Disk is averaged over every disk on every host. Tiles turn amber at 70% and red at 85%."
    },
    "1": {
      "title": "Hosts reporting",
      "type": "data",
      "query": "timeseries v = avg(dt.host.cpu.usage), by: {dt.entity.host}\n| summarize hosts = count()",
      "visualization": "singleValue",
      "visualizationSettings": {
        "singleValue": {
          "label": "hosts",
          "recordField": "hosts",
          "showLabel": true
        }
      }
    },
    "2": {
      "title": "Avg CPU usage (%)",
      "type": "data",
      "query": "timeseries v = avg(dt.host.cpu.usage)\n| fieldsAdd value = round(arrayAvg(v), decimals: 1)\n| fields value",
      "visualization": "singleValue",
      "visualizationSettings": {
        "singleValue": {
          "label": "% CPU, all hosts",
          "recordField": "value",
          "showLabel": true,
          "colorThresholdTarget": "background"
        },
        "thresholds": [
          {
            "id": 1,
            "field": "value",
            "title": "",
            "isEnabled": true,
            "rules": [
              {
                "id": 0,
                "color": {
                  "Default": "var(--dt-colors-charts-status-ideal-default, #2f6863)"
                },
                "comparator": "≥",
                "label": "",
                "value": 0
              },
              {
                "id": 1,
                "color": {
                  "Default": "var(--dt-colors-charts-status-warning-default, #eea53c)"
                },
                "comparator": "≥",
                "label": "",
                "value": 70
              },
              {
                "id": 2,
                "color": {
                  "Default": "var(--dt-colors-charts-status-critical-default, #c4233b)"
                },
                "comparator": "≥",
                "label": "",
                "value": 85
              }
            ]
          }
        ]
      }
    },
