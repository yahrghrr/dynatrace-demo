    "5": {
      "title": "Average utilization over time, all hosts (%)",
      "type": "data",
      "query": "timeseries {\n  `CPU` = avg(dt.host.cpu.usage),\n  `Memory` = avg(dt.host.memory.usage),\n  `Disk used` = avg(dt.host.disk.used.percent)\n}",
      "visualization": "lineChart",
      "visualizationSettings": {}
    },
    "6": {
      "title": "Per-host averages (%)",
      "type": "data",
      "query": "timeseries {\n  cpu = avg(dt.host.cpu.usage),\n  mem = avg(dt.host.memory.usage),\n  disk = avg(dt.host.disk.used.percent)\n}, by: {dt.entity.host}\n| fieldsAdd Host = entityName(dt.entity.host),\n    `CPU %` = round(arrayAvg(cpu), decimals: 1),\n    `Memory %` = round(arrayAvg(mem), decimals: 1),\n    `Disk used %` = round(arrayAvg(disk), decimals: 1)\n| fields Host, `CPU %`, `Memory %`, `Disk used %`\n| sort `CPU %` desc",
      "visualization": "table",
      "visualizationSettings": {}
